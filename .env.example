# API Configuration
# En Android físico usa la IP LAN del backend, no localhost.
EXPO_PUBLIC_API_URL=https://apirecovery.kognitoai.cloud
API_TIMEOUT=30000

# LLM Configuration (OpenAI/Anthropic/etc)
LLM_API_KEY=your_llm_api_key_here
LLM_MODEL=gpt-4
LLM_MAX_TOKENS=1000
LLM_TEMPERATURE=0.7

# Sentry Error Tracking
SENTRY_DSN=https://your-sentry-dsn@sentry.io/your-project-id
SENTRY_ENV=development

# Firebase (si se usa para push notifications)
FIREBASE_API_KEY=your_firebase_api_key
FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_STORAGE_BUCKET=your-project.appspot.com
FIREBASE_MESSAGING_SENDER_ID=your-sender-id
FIREBASE_APP_ID=your-app-id

# App Configuration
APP_ENV=development
APP_VERSION=1.0.0
APP_FLAVOR=dev

# Feature Flags
ENABLE_ANALYTICS=false
ENABLE_CRASHLYTICS=false
ENABLE_CHATBOT=true
ENABLE_FAMILY_DASHBOARD=true

# Security
JWT_SECRET=your_jwt_secret_key_min_32_chars
ENCRYPTION_KEY=your_encryption_key_32_chars
ENCRYPTION_SALT=your_encryption_salt_32_chars
# Secreto de sesión del panel web (Next.js) — obligatorio en docker-compose
WEB_SESSION_SECRET=your_web_session_secret_min_32_chars

# Database (para desarrollo local)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/kognirecovery_dev
REDIS_URL=redis://localhost:6379

# =====================================================
# SEC-PHASE1: variables OBLIGATORIAS (el servidor no arranca sin ellas)
# =====================================================
# Neo4j (grafos clínicos). Generar con: openssl rand -base64 18 | tr -d '/' | head -c 24
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_neo4j_password
NEO4J_DATABASE=neo4j

# Redis (contraseña requerida para conexiones del API)
REDIS_PASSWORD=your_redis_password

# pgAdmin (solo perfil 'tools' local; nunca admin/admin)
PGADMIN_DEFAULT_EMAIL=admin@kognirecovery.com
PGADMIN_DEFAULT_PASSWORD=your_pgadmin_password

# Telegram Services
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_key
STRIPE_SECRET_KEY=sk_test_your_stripe_key

# TTS (Text-to-Speech) — Voz del asistente
# Kokoro es el servidor local (docker-compose) y el fallback por defecto.
# ElevenLabs se configura desde el panel de administración (IA → Voz); estas
# variables sirven como valores por defecto globales.
TTS_KOKORO_URL=http://localhost:8009
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=XB0fDUnXU5powFXDhCwa
ELEVENLABS_MODEL=eleven_multilingual_v2

# Emergency Services
EMERGENCY_PHONE=911
EMERGENCY_EMAIL=emergencia@kognirecovery.com
