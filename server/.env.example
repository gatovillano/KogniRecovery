# =====================================================
# KogniRecovery - Backend Environment Configuration
# =====================================================
# Copia este archivo a .env y configura los valores
# NO commitees .env al repositorio
# =====================================================

# =====================================================
# SERVER CONFIGURATION
# =====================================================
NODE_ENV=development
PORT=3002
API_URL=http://localhost:3002
API_VERSION=v1

# =====================================================
# DATABASE CONFIGURATION
# =====================================================
# PostgreSQL connection string
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/kognirecovery_dev

# Database pool settings
DB_POOL_MIN=2
DB_POOL_MAX=10
DB_POOL_IDLE_TIMEOUT=30000

# =====================================================
# JWT CONFIGURATION
# =====================================================
# Tokens de acceso (short-lived)
JWT_SECRET=your_jwt_secret_key_min_32_chars_here_change_in_production
JWT_EXPIRES_IN=15m

# Refresh tokens (long-lived)
JWT_REFRESH_SECRET=your_refresh_token_secret_min_64_chars_here_change_in_production
JWT_REFRESH_EXPIRES_IN=7d

# =====================================================
# AUTH CONFIGURATION
# =====================================================
# Password requirements
PASSWORD_MIN_LENGTH=8
PASSWORD_REQUIRE_UPPERCASE=true
PASSWORD_REQUIRE_LOWERCASE=true
PASSWORD_REQUIRE_NUMBER=true
PASSWORD_REQUIRE_SPECIAL=true

# Session configuration
MAX_LOGIN_ATTEMPTS=5
LOGIN_LOCKOUT_DURATION=15
TOKEN_ROTATION_ENABLED=true

# =====================================================
# CORS CONFIGURATION
# =====================================================
CORS_ORIGIN=http://localhost:8081
CORS_ORIGIN_WEB=http://localhost:19006
CORS_METHODS=GET,POST,PUT,DELETE,OPTIONS,PATCH
CORS_ALLOWED_HEADERS=Content-Type,Authorization,X-Requested-With
CORS_CREDENTIALS=true

# =====================================================
# RATE LIMITING
# =====================================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Auth endpoint rate limits
AUTH_RATE_LIMIT_MAX=5
AUTH_RATE_LIMIT_WINDOW_MS=60000

# =====================================================
# LOGGING
# =====================================================
LOG_LEVEL=debug
LOG_FILE_PATH=./logs/app.log

# =====================================================
# EXTERNAL SERVICES (optional)
# =====================================================
# Redis for session storage (optional)
REDIS_URL=redis://localhost:6379

# Email service (optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@kognirecovery.com

# =====================================================
# SECURITY
# =====================================================
BCRYPT_ROUNDS=12
ENCRYPTION_KEY=your_encryption_key_32_chars_minimum

# =====================================================
# AI/LLM CONFIGURATION (Motor LÚA)
# =====================================================
# Configuración por defecto del sistema (OpenRouter gratuito con intermitencias)
# Los usuarios nuevos automáticamente usan esta configuración a menos que configuren la suya propia

# OpenRouter (Recomendado para usuarios nuevos - modelo gratuito)
# Regístrate en https://openrouter.ai y obtén tu API key
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=stepfun/step-3.5-flash:free

# OpenAI (Opcional - requiere API key de pago)
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4o

# Configuración genérica (para proveedores compatibles con OpenAI)
LLM_PROVIDER=openrouter
LLM_MODEL=
LLM_API_KEY=
LLM_BASE_URL=

# Embedding model (para búsqueda semántica)
OPENAI_EMBEDDING_MODEL=Xenova/all-MiniLM-L6-v2
OPENAI_MAX_TOKENS=1000

# NOTA: La prioridad de API keys es:
# 1. OPENROUTER_API_KEY (por defecto para usuarios nuevos - gratuito)
# 2. OPENAI_API_KEY
# 3. LLM_API_KEY
# 4. Valores hardcodeados en neo4j.ts (solo fallback)
#
# Los usuarios pueden configurar su propio proveedor y modelo desde la app.
# Si no configuran nada, se usa OPENROUTER_API_KEY con modelo gratuito.

# =====================================================
# APPLICATION SPECIFIC
# =====================================================
APP_NAME=KogniRecovery
APP_URL=http://localhost:19006
SUPPORT_EMAIL=soporte@kognirecovery.com
EMERGENCY_PHONE=911
